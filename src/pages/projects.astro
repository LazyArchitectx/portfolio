---
// src/pages/projects.astro
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---
<Base title="Projects — ZEE">
  <h1 class="text-3xl font-bold">Projects</h1>

  <ul class="mt-8 grid gap-6 sm:grid-cols-2">
    {projects.map((p) => (
      <li class="rounded-lg border border-gray-200 p-5 dark:border-gray-800">
        <span class="text-xs font-semibold uppercase tracking-wide text-brand">{p.category}</span>
        <h2 class="mt-1 text-lg font-semibold">
          <a href={p.repo} rel="noopener" class="hover:underline">{p.name}</a>
        </h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{p.summary}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {p.highlights.map((h) => (
            <li class="rounded bg-gray-100 px-2 py-0.5 text-xs dark:bg-gray-800">{h}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</Base>